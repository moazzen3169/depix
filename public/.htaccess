# Header & Caching Configuration for Versioning and Cache Busting

<IfModule mod_headers.c>
    # 1. HTML files must NOT be cached immutably or long-term so updated asset references are immediately fetched after deployment.
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # 2. Hashed / Versioned JS and CSS files (e.g., main.a1b2c3d4.js, output.a1b2c3d4.css)
    # These files are immutable and can be cached long-term.
    <FilesMatch "\.([a-f0-9]{8})\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
